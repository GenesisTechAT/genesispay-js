{
  "name": "genesispay-js",
  "version": "0.1.0",
  "private": true,
  "description": "GenesisPay JavaScript SDKs: x402 payment gate for sellers, agent payment client, MCP server, and protocol helpers.",
  "license": "MIT",
  "author": "GenesisTech",
  "homepage": "https://github.com/GenesisTechAT/genesispay-js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GenesisTechAT/genesispay-js.git"
  },
  "bugs": {
    "url": "https://github.com/GenesisTechAT/genesispay-js/issues"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b packages/protocol packages/seller-sdk packages/agent-sdk packages/mcp-server",
    "typecheck": "npm run build",
    "test": "vitest run",
    "verify:artifacts": "node scripts/verify-package-artifacts.mjs"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  }
}
