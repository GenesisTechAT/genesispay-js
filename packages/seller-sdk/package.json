{
  "name": "@genesis-tech/genesispay-seller",
  "version": "1.3.0",
  "description": "Seller SDK for strict GenesisPay fulfilment verification, checkout, and x402 gates.",
  "license": "MIT",
  "author": "GenesisTech",
  "homepage": "https://github.com/GenesisTechAT/genesispay-js/tree/main/packages/seller-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GenesisTechAT/genesispay-js.git",
    "directory": "packages/seller-sdk"
  },
  "bugs": {
    "url": "https://github.com/GenesisTechAT/genesispay-js/issues"
  },
  "keywords": [
    "x402",
    "http-402",
    "payments",
    "usdc",
    "stablecoin",
    "base",
    "paywall",
    "api-monetization",
    "payment-gate"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.9.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "prepack": "npm run build -- --force",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@genesis-tech/genesispay-protocol": "^0.5.0",
    "viem": "^2.48.11"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
